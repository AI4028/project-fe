{
  "name": "galjido",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "pnpm dev",
    "dev": "concurrently -k -n checks,expo \"pnpm check:watch\" \"expo start\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "verify": "pnpm typecheck && pnpm test",
    "check:watch": "node scripts/check-watch.mjs",
    "export:web": "expo export --platform web",
    "export:all": "expo export --platform all",
    "format": "prettier --write src tests scripts *.js *.ts *.json",
    "format:check": "prettier --check src tests scripts *.js *.ts *.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/dialog": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "58.0.0",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "1.62.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.12",
    "prettier": "3.6.2",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
