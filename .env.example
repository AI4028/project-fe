# Physical phones must use the computer's LAN IP or a reachable HTTPS API.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Enable only with backend DEMO_MODE=1. Never enable in production.
EXPO_PUBLIC_DEMO_MODE=false
# Web: Kakao JavaScript key with the web app's origin registered in Kakao.
EXPO_PUBLIC_KAKAO_MAP_KEY=
# Android native map: restricted Google Maps SDK for Android key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
